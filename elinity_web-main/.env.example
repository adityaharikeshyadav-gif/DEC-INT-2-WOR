# Frontend environment example
# Copy this file to `.env` in the project root for local frontend overrides.

# Backend API base URL used by trips, experiences, conversations, games, and voice flows.
# The app defaults to http://localhost:8000 if this is not set.
VITE_API_URL=http://localhost:8000

# Optional: only needed if Supabase-backed auth/data features are enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
